# =============================================================================
# Gold Intelligence n8n — environment template
# Copy to .env (local: `node tools/setup-local.js` does it and generates local
# passwords). NEVER commit .env. Secrets are read by n8n from the process
# environment only; they never appear in workflow JSON.
# =============================================================================

# ---- Secrets (owner-supplied) ------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Comma-separated list of authorised chat IDs. The first one receives alerts.
TELEGRAM_CHAT_ID=
OPENROUTER_API_KEY=
# Optional. Enables WTI oil, VIX and broad-dollar series from FRED.
FRED_API_KEY=

# ---- Runtime -----------------------------------------------------------------
GENERIC_TIMEZONE=Africa/Casablanca
TZ=Africa/Casablanca
# Generated by setup-local.js; keep it stable or stored credentials become unreadable.
N8N_ENCRYPTION_KEY=
# Identifying User-Agent (BLS and other official sites reject anonymous clients).
GI_HTTP_USER_AGENT=GoldIntel-n8n/0.1 (automated macro research bot)
GI_HTTP_TIMEOUT_MS=20000

# ---- Gold-intelligence data store (PostgreSQL) -------------------------------
GI_PG_HOST=127.0.0.1
GI_PG_PORT=5433
GI_PG_DATABASE=gold_intel
GI_PG_USER=gold_intel
GI_PG_PASSWORD=
# n8n's own database (local pilot uses the same PostgreSQL server).
N8N_DB_DATABASE=n8n


# ---- AI gateway (OpenRouter) -------------------------------------------------
# Ordered: PRIMARY, SECONDARY, TERTIARY. Re-verify free availability (AI_MODELS.md).
GI_AI_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free
GI_AI_TIMEOUT_MS=60000
GI_AI_MAX_TOKENS=3000
# Hard cap on AI requests per calendar day (all models). Free tier is ~50/day.
GI_AI_DAILY_BUDGET=40
GI_AI_MIN_RELEVANCE=70
GI_AI_MIN_IMPORTANCE=70
GI_AI_MAX_EVENTS_PER_RUN=2

# ---- AI usage / quota monitoring --------------------------------------------
# Model chain by rank; an empty value falls back to the same position in GI_AI_MODELS.
OPENROUTER_PRIMARY_MODEL=
OPENROUTER_SECONDARY_MODEL=
OPENROUTER_TERTIARY_MODEL=
# Operational caps (supersede GI_AI_DAILY_BUDGET / GI_AI_MAX_TOKENS when set).
# OpenRouter free models: 20 req/min and 50 req/UTC day (1000/day after >= 10 credits purchased),
# shared by all :free models of the account. The provider counter (GET /api/v1/key) is preferred.
AI_MAX_REQUESTS_DAY=40
# 0 = no hourly cap (burst guard off)
AI_MAX_REQUESTS_HOUR=12
# 0 = no token cap (token quota shown as not configured)
AI_MAX_TOKENS_DAY=0
AI_MAX_TOKENS_REQUEST=3000
# Quota states: HEALTHY < warning <= LOW < critical <= NEAR_LIMIT < 100% = LIMIT_REACHED
AI_USAGE_WARNING_PERCENT=70
AI_USAGE_CRITICAL_PERCENT=90
# Fallbacks per hour before a (single) persistent-fallback alert
AI_FALLBACK_THRESHOLD=3
# Minutes between AI health checks (model list, key counter, idle-model probes)
AI_HEALTH_CHECK_INTERVAL=60
# idle = tiny probe only for models without traffic for AI_HEALTH_PROBE_IDLE_HOURS; off = never probe
AI_HEALTH_PROBE=idle
AI_HEALTH_PROBE_IDLE_HOURS=12
# Reuse an AI analysis while its material context is unchanged (0 disables the cache)
AI_CACHE_TTL_MIN=180
AI_USAGE_ALERT_COOLDOWN_MIN=180
# Daily report AI section: auto (only when something happened) | always | never
AI_DAILY_REPORT_SECTION=auto
# Non-secret label of the OpenRouter key (shown in /ai views; the key itself never is)
AI_KEY_ALIAS=openrouter-main
# Per-model timeout for the user-requested 🔮 BIGGEST SCENARIOS explanation (bot)
AI_BOT_TIMEOUT_MS=25000
# Reasoning for the AI analyst: off (default; reasoning tokens used up the answer budget in live tests) | low
AI_REASONING=off

# ---- Scoring / alert thresholds (0-100) --------------------------------------
GI_RETAIN_MIN_RELEVANCE=35
GI_ALERT_MIN_RELEVANCE=60
GI_ALERT_MIN_IMPORTANCE=65
GI_ALERT_MAX_PER_RUN=3
GI_ALERT_COOLDOWN_MIN=120
GI_DEDUP_WINDOW_HOURS=36
GI_DEDUP_MIN_COVERAGE=0.6
GI_MAX_ITEM_AGE_HOURS=24
GI_HIST_MIN_SAMPLE=8

# ---- Calibrated probabilities (docs/CALIBRATION.md) ---------------------------
# A probability is shown only for a cell with at least this many NON-OVERLAPPING historical cases that also
# passes a chronological walk-forward check. 20: the 95 % Wilson interval of a 50 % share is about +-21 points;
# below it the percentages are mostly noise. Range 10-500.
GI_PROB_MIN_SAMPLE=20
# Minimum walk-forward (out-of-sample) predictions per cell, and cases used as warm-up before the first one
GI_PROB_MIN_EVAL=10
GI_PROB_WARMUP=10

# ---- Schedules ---------------------------------------------------------------
GI_NEWS_INTERVAL_MIN=15
GI_MARKET_INTERVAL_MIN=10
GI_BOT_POLL_SECONDS=30
GI_HEALTH_INTERVAL_MIN=5
GI_POST_EVENT_INTERVAL_MIN=30
GI_PREEVENT_REFRESH_INTERVAL_MIN=30
# Local hour (GENERIC_TIMEZONE) for the daily pre-event run and the daily report.
GI_PREEVENT_DAILY_HOUR=6
GI_DAILY_REPORT_HOUR=7
GI_PREEVENT_LOOKAHEAD_HOURS=36
GI_PREEVENT_REFRESH_LEAD_MIN=90
GI_TECH_ALERT_COOLDOWN_MIN=60
